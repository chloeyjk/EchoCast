# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEWS_API_KEY=

# Local (non-docker) run. docker-compose overrides these for the containers.
DATABASE_URL=postgresql+psycopg://echocast:echocast@localhost:5432/echocast
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

POSTGRES_USER=echocast
POSTGRES_PASSWORD=echocast
POSTGRES_DB=echocast
