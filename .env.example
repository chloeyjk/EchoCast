# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
NEWS_API_KEY=

# Ingestion (optional; defaults shown)
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_WORDS=600
CHUNK_OVERLAP_WORDS=75
INGEST_INTERVAL_MINUTES=60
INGEST_ARTICLES_PER_TOPIC=10

# Retrieval (optional; defaults shown)
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_FINAL_K=5

# Local (non-docker) run. docker-compose overrides these for the containers.
DATABASE_URL=postgresql+psycopg://echocast:echocast@localhost:5432/echocast
REDIS_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

POSTGRES_USER=echocast
POSTGRES_PASSWORD=echocast
POSTGRES_DB=echocast
